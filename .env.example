# Copy to .env and adjust. Every key maps 1:1 to app/config.py (Settings).

# --- Storage --------------------------------------------------------------
# sql = database via SQLAlchemy, data survives restart (default) | memory = in-process, lost on restart
REPO_MODE=sql
# sqlite (file, zero setup) | postgres (server; docker compose provides one)
DB_ENGINE=sqlite
SQLITE_PATH=data/rampa.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rampa
POSTGRES_PASSWORD=rampa
POSTGRES_DB=rampa
# optional override: any SQLAlchemy URL (wins over the settings above), e.g. postgresql+psycopg://u:p@h:5432/db
DATABASE_URL=
# docker compose only: host ports
API_PORT=8000
POSTGRES_HOST_PORT=5432

# --- Auth -----------------------------------------------------------------
# demo = seeded accounts, offline (default) | google = Google Sign-In (needs internet)
AUTH_MODE=demo
# OAuth "Web" client id from Google Cloud Console (only for AUTH_MODE=google)
GOOGLE_CLIENT_ID=
# comma-separated emails that get role=admin in google mode
ADMIN_EMAILS=
SESSION_TTL_HOURS=24
# POST /auth/anonymous: identity per device for the map front end (works in both auth modes)
ANONYMOUS_AUTH=true
ANONYMOUS_TTL_DAYS=365

# --- Demo / files -----------------------------------------------------------
MEDIA_DIR=media
# fixed "now" for a deterministic live demo, e.g. 2026-10-03T12:00:00+02:00
DEMO_NOW=

# --- Open API (/public/v1) ----------------------------------------------------
# comma-separated X-Api-Key values + per-key limit
PUBLIC_API_KEYS=demo-key
PUBLIC_RATE_LIMIT_PER_MIN=60

# --- OSM import ---------------------------------------------------------------
OSM_FILE=data/osm_krakow_tauron.json
# F27 live OSM (fallback to local index / OSM_FILE on any failure)
GEOCODER=local
# F33 e-mail login: console (log; demo returns dev_token) | smtp
MAILER=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@example.com
# EMAIL_LINK_URL=https://front-end.example/login
# F41 remote MCP: its own env file → .mcpenv (template .mcpenv.example); here only the host port
# MCP_PORT=8080
# F43 rate limits (0 = off); on Render set TRUSTED_PROXY_HOPS=1
# AI_RATE_LIMIT_PER_MIN=10
# AI_RATE_LIMIT_PER_IP_PER_MIN=30
# AUTH_RATE_LIMIT_PER_MIN=20
# TRUSTED_PROXY_HOPS=0
# F30 AI recommendations: rules (offline) | claude
AI_RECOMMENDER=rules  # rules | claude | gemini
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5
# F28 walking route: straight (offline) | osrm
ROUTER=straight
# OSRM_URL=https://routing.openstreetmap.de/routed-foot
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# F37 city: JSON file (default data/cities/krakow.json); OSM_* override its centre / radius
# CITY_CONFIG=data/cities/krakow.json
# OSM_CENTER_LAT=
# OSM_CENTER_LON=
# OSM_RADIUS_M=

# --- AI photo suggestions -------------------------------------------------------
# mock (offline, deterministic) | onnx (Phi-3.5 Vision, needs: uv sync --extra ai + models/)
# | gemini (Google Gemini API, needs GEMINI_API_KEY + internet). Any failure → mock.
AI_MODE=mock
AI_MODEL_PATH=models/gpu/gpu-int4-rtn-block-32
AI_TIMEOUT_S=60
# F44: Gemini failed → local ONNX model (needs onnxruntime-genai + AI_MODEL_PATH) → mock. mock | onnx
AI_VISION_FALLBACK=mock
AI_ONNX_TIMEOUT_S=180
# Gemini (AI_MODE=gemini). Key from https://aistudio.google.com/apikey — keep it ONLY in .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
