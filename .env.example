# demo = seeded accounts, offline (default) | google = Google Sign-In (needs internet)
AUTH_MODE=demo
# OAuth "Web" client id from Google Cloud Console (only for AUTH_MODE=google)
GOOGLE_CLIENT_ID=
# comma-separated emails that get role=admin in google mode
ADMIN_EMAILS=
MEDIA_DIR=media
# fixed "now" for a deterministic live demo, e.g. 2026-10-03T12:00:00+02:00
DEMO_NOW=
# Open API (/public/v1): comma-separated X-Api-Key values + per-key limit
PUBLIC_API_KEYS=demo-key
PUBLIC_RATE_LIMIT_PER_MIN=60
